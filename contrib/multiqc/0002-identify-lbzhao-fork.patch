From 13bcf5b9ffa25bdda77a9e036ac0815f16b12791 Mon Sep 17 00:00:00 2001
From: LBZhao <zhaolinbo@gmail.com>
Date: Sun, 8 Nov 2026 19:08:02 +0000
Subject: [PATCH 2/2] Identify the LBZhao fork: version 1.36.dev0+lbzhao,
 README notice

This fork is the official MultiQC plus the RSeQC change in the previous
commit. Mark it so it cannot be mistaken for official MultiQC:

- Version 1.36.dev0+lbzhao (a local version), which every report shows.
- README notice: what the fork changes, how to install it, and the
  GPL-3.0 section 5(a) modification notice with date.
- Project URLs point to LBZhao/MultiQC and the original.
---
 README.md      | 20 ++++++++++++++++++++
 pyproject.toml |  7 ++++---
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/README.md b/README.md
index a4ff51a..8642fee 100644
--- a/README.md
+++ b/README.md
@@ -16,6 +16,26 @@
 
 ---
 
+> [!IMPORTANT]
+> **This is the LBZhao fork of MultiQC, not the official MultiQC.**
+> It is the official MultiQC (`main` at `a286ece`) plus one change: the RSeQC
+> module also reads the two report categories added by the
+> [LBZhao fork of RSeQC](https://github.com/LBZhao/RSeQC) (5.1.0+lbzhao):
+> `Novel Combination` splice junctions and `Noncoding_Exons` in the read
+> distribution. Official RSeQC output is reported exactly as by official
+> MultiQC. The version is `1.36.dev0+lbzhao`, and every report shows it.
+>
+> Install: `pip install git+https://github.com/LBZhao/MultiQC.git`
+> (`pip install multiqc` installs the official MultiQC instead; both use the
+> same package name, so installing one replaces the other.)
+>
+> **Modification notice (GPL-3.0 section 5a):** modified by LBZhao in
+> November 2026; the changes are the commits after `a286ece` in this
+> repository. For support with this fork, use
+> https://github.com/LBZhao/MultiQC, not the MultiQC project.
+
+---
+
 MultiQC is a tool to create a single report with interactive plots for multiple bioinformatics analyses across many samples.
 
 Reports are generated by scanning given directories for recognised log files.
diff --git a/pyproject.toml b/pyproject.toml
index 416e8b2..9c12497 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -4,7 +4,7 @@ build-backend = "setuptools.build_meta"
 
 [project]
 name = "multiqc"
-version = "1.36dev"
+version = "1.36.dev0+lbzhao"
 dependencies = [
     "boto3",              # for aws bedrock ai support
     "click",
@@ -43,7 +43,7 @@ authors = [
     { name = "Phil Ewels", email = "phil.ewels@seqera.io" },
     { name = "Vlad Savelyev", email = "vladislav.sav@gmail.com" },
 ]
-description = "Create aggregate bioinformatics analysis reports across many samples and tools"
+description = "Create aggregate bioinformatics analysis reports across many samples and tools (LBZhao fork: adds RSeQC 5.1.0+lbzhao categories)"
 readme = "README.md"
 license = { file = "LICENSE" }
 keywords = [
@@ -97,7 +97,8 @@ dev = [
 
 [project.urls]
 Homepage = "https://multiqc.info"
-Repository = "https://github.com/MultiQC/MultiQC"
+Repository = "https://github.com/LBZhao/MultiQC"
+"Original MultiQC" = "https://github.com/MultiQC/MultiQC"
 Issues = "https://github.com/MultiQC/MultiQC/issues"
 Documentation = "https://docs.seqera.io/multiqc"
 Changelog = "https://github.com/MultiQC/MultiQC/blob/main/CHANGELOG.md"
-- 
